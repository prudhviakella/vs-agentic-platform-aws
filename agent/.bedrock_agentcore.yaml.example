# AgentCore CLI configuration
# Generated by: agentcore configure --entrypoint agent.py
# Deploy with: agentcore launch

entrypoint: agent.py
region: us-east-1
deployment_type: container  # uses Dockerfile + ECR

execution_role: arn:aws:iam::ACCOUNT_ID:role/vs-agentcore-agent-role

environment_variables:
  SSM_PREFIX: /vs-agentcore/prod
  AWS_REGION: us-east-1

# AgentCore handles:
#   - Session isolation (each session = dedicated microVM)
#   - Scaling (0 to N sessions automatically)
#   - Health checks via /ping endpoint
#   - SSE streaming via async generator entrypoint
