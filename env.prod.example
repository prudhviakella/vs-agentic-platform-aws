# ============================================================
# vs-agentcore-platform-aws — Environment Variables
# ============================================================
#
# SETUP:
#   cp .env.prod.example .env.prod
#   # Edit .env.prod and fill every value marked <...>
#   source .env.prod                # load into shell
#   ./scripts/deploy.sh secrets     # push to AWS Secrets Manager + SSM
#
# NEVER commit .env.prod to git — it contains real API keys.
# .gitignore already excludes it.
# ============================================================


# ── AWS ──────────────────────────────────────────────────────────────────
# Region where all resources are deployed.
# AgentCore is only available in us-east-1 — do not change.
AWS_REGION=us-east-1

# SSM parameter path prefix — all config lives under this path.
# Must match the SSM_PREFIX environment variable passed to ECS + Lambda.
SSM_PREFIX=/vs-agentcore/prod


# ── OpenAI ───────────────────────────────────────────────────────────────
# Used by:
#   Agent:       GPT-4o (reasoning) + text-embedding-3-small (vectors)
#   Guardrail:   GPT-4o-mini (faithfulness judge)
#   search_lambda: text-embedding-3-small (query embedding)
#   summariser_lambda: GPT-4o-mini (chunk synthesis)
# Get from: platform.openai.com → API keys
OPENAI_API_KEY=sk-proj-<your-openai-key>


# ── Pinecone ─────────────────────────────────────────────────────────────
# PINECONE_API_KEY:        get from app.pinecone.io → API keys
# CLINICAL_TRIALS_INDEX:  the index holding 5,772 clinical trial chunks
#                         (created during local setup — same index)
# PINECONE_INDEX_NAME:    the index for semantic cache + episodic memory
#                         (created during local setup — same index)
PINECONE_API_KEY=pcsk_<your-pinecone-key>
CLINICAL_TRIALS_INDEX=clinical-trials-index
PINECONE_INDEX_NAME=clinical-agent


# ── Neo4j AuraDB ─────────────────────────────────────────────────────────
# Same AuraDB instance as local setup — no new database needed.
# Get from: console.neo4j.io → your instance → Connection details
NEO4J_URI=neo4j+s://52c31090.databases.neo4j.io
NEO4J_USER=52c31090
NEO4J_PASSWORD=<your-neo4j-password>


# ── Postgres (RDS) ───────────────────────────────────────────────────────
# ⚠️  LEAVE BLANK on first deploy — RDS doesn't exist yet.
#
# ORDER OF OPERATIONS:
#   1. Run: ./scripts/deploy.sh secrets  (with POSTGRES_URL blank — will warn)
#   2. Run: ./scripts/deploy.sh iam lambdas gateway agent
#   3. Run: ./scripts/deploy.sh platform  (Terraform creates RDS here)
#   4. Get RDS endpoint: cd infra && terraform output rds_endpoint
#   5. Fill POSTGRES_URL below and re-run: ./scripts/deploy.sh secrets
#
# FORMAT: postgresql://postgres:<password>@<rds-endpoint>:5432/clinical_agent
# The deploy.sh secrets step parses this URL and stores the individual
# fields (username/password/host/port/dbname) in Secrets Manager.
POSTGRES_URL=postgresql://postgres:<your-rds-password>@<rds-endpoint>.us-east-1.rds.amazonaws.com:5432/clinical_agent


# ── Platform API Key ─────────────────────────────────────────────────────
# Secret key that authenticates all requests to the FastAPI platform.
# The Chainlit UI sends this as the X-API-Key header on every request.
# Generate a strong random key:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
PLATFORM_API_KEY=<generate-with-python-secrets-token-hex-32>


# ── Bedrock Prompt Management ─────────────────────────────────────────────
# Same prompt as local setup.
# BEDROCK_PROMPT_ID:      the ID returned by: aws bedrock-agent create-prompt
# BEDROCK_PROMPT_VERSION: the version number from: aws bedrock-agent create-prompt-version
#
# If you already ran the local setup, use the same values.
# The agent always fetches the prompt text at cold start — no redeployment
# needed when you update the prompt (just call POST /prompt/reload?new_version=N).
BEDROCK_PROMPT_ID=YEVDY4MYU6
BEDROCK_PROMPT_VERSION=6


# ── LangSmith (optional but recommended) ─────────────────────────────────
# Visualise the full agent execution tree with timing per node.
# Get from: smith.langchain.com → Settings → API Keys
# Set LANGCHAIN_TRACING_V2=false to disable tracing entirely.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_<your-langsmith-key>
LANGSMITH_PROJECT=vs-agentcore-prod
